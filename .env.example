APP_NAME=Markor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shown on the "Biz taklif qilamiz" page
CONTACT_PHONE=
CONTACT_TELEGRAM=

# Price per loaded DataMatrix code and default discount in percent (100 = free)
BILLING_PRICE_PER_CODE=9
BILLING_DISCOUNT_PERCENT=0

# Development only (APP_ENV=local): corner switch to view the app as super admin or as a client
DEV_ROLE_SWITCH=false

# Company details by tax number; leave empty and clients enter them by hand
# Product info by GTIN (tasnif.soliq.uz), {gtin} = the barcode
GTIN_LOOKUP_URL=https://tasnif.soliq.uz/api/cl-api/integration-mxik/get/information/?shtrixCode={gtin}

COMPANY_LOOKUP_URL=
COMPANY_LOOKUP_AUTHORIZATION=

# Telegram bot: token from @BotFather; webhook secret = any random string
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ARCHIVE_CHAT=
# New companies: welcome discount in percent for N months
BILLING_FREE_MONTHS=1
BILLING_CARD_NUMBER=
BILLING_CARD_HOLDER=

# Super admin (created by SuperAdminSeeder if missing; existing password is never overwritten)
# Production: a strong password of 12+ characters is required
SUPER_ADMIN_NAME=Administrator
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
